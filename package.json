{
  "name": "morrow",
  "version": "1.0.0-alpha.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "clean": "pnpm -r --if-present clean",
    "typecheck": "pnpm build",
    "test": "pnpm build && pnpm -r --if-present test",
    "check": "pnpm test",
    "start": "pnpm --filter @morrow/mcp-server start",
    "catalog:legacy": "node scripts/export-example-legacy-catalog.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
