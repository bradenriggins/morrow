{
  "name": "morrow",
  "version": "1.0.0-alpha.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "clean": "pnpm -r --if-present clean",
    "typecheck": "pnpm build",
    "test": "pnpm build && pnpm -r --if-present test && pnpm scripts:test",
    "scripts:test": "node --test scripts/test/*.test.mjs",
    "check": "pnpm test",
    "start": "pnpm --filter @morrow/mcp-server start",
    "clients:render": "pnpm build && node packages/client-config/dist/cli.js",
    "catalog:legacy": "pnpm build && node scripts/export-example-legacy-catalog.mjs",
    "catalog:capture": "pnpm build && node scripts/capture-upstream-catalog.mjs",
    "catalog:reconcile": "pnpm build && node scripts/reconcile-catalogs.mjs",
    "catalog:export": "pnpm catalog:legacy",
    "catalog:merge": "pnpm build && node scripts/catalog-report.mjs",
    "catalog:check": "pnpm build && node scripts/check-catalog-artifacts.mjs",
    "catalog:report": "pnpm catalog:merge",
    "catalog:scan": "node scripts/scan-held-provider-inputs.mjs",
    "publication:build": "pnpm build && node scripts/create-publication-policy.mjs",
    "bridge:legacy:start": "pnpm build && pnpm --filter @morrow/legacy-bridge-mcp start",
    "bridge:legacy:install": "node scripts/install-example-legacy-bridge.mjs",
    "bridge:legacy:remove": "node scripts/remove-example-legacy-bridge.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
