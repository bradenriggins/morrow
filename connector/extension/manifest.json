{
  "manifest_version": 3,
  "name": "Morrow Canvas Connector",
  "description": "Connect signed-in Canvas sessions to the local Morrow MCP. No Canvas credentials leave Chrome.",
  "version": "1.0.0",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": { "128": "brand/morrow.png" },
  "permissions": ["activeTab", "alarms", "scripting", "storage", "tabs", "webNavigation"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Morrow Canvas Connector",
    "default_icon": "brand/morrow.png",
    "default_popup": "popup/popup.html"
  }
}
