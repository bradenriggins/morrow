{
  "manifest_version": 3,
  "name": "Morrow Bridge",
  "description": "Morrow Bridge connects Canvas and Moodle to Morrow from your assistant. Your learning-platform sign-in stays in Chrome.",
  "version": "1.0.2",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": { "128": "brand/morrow-knot-128.png" },
  "permissions": ["activeTab", "alarms", "offscreen", "scripting", "storage", "tabs", "webNavigation", "webRequest"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Morrow Bridge",
    "default_icon": "brand/morrow-knot-128.png",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "sandbox": {
    "pages": ["render-check/render-check.html"]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self'; base-uri 'none'; form-action 'none'"
  }
}
