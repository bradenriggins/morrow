{
  "schema": "morrow.upstreams.v1",
  "profile": "private-full",
  "disposition": "Development-only example. The example-legacy bridge is a development adaptation path for the donor Morrow extension. It is not part of the Morrow 1.0 product, no public release profile in config/release-profiles.json contains packages/legacy-bridge-mcp/, and it needs an external example-legacy donor checkout at revision 1111111111111111111111111111111111111111. See docs/implementation/MORROW-LEGACY-BRIDGE.md.",
  "sourcePolicy": {
    "requireAttestation": true
  },
  "upstreams": [
    {
      "id": "meridian",
      "label": "ExamplePlatform hermetic catalog",
      "kind": "meridian-ssh",
      "host": "your-meridian-ssh-host",
      "remoteRoot": "/tmp/morrow-meridian-donor-00000000",
      "serverPath": "scripts/team/mcp/meridian_server.py",
      "repository": "your-org/your-meridian-repo",
      "revision": "0000000000000000000000000000000000000000",
      "attestation": {
        "kind": "remote-git-ssh",
        "host": "your-meridian-ssh-host",
        "root": "/tmp/morrow-meridian-donor-00000000",
        "expectedRevision": "0000000000000000000000000000000000000000",
        "requireTrackedClean": true
      },
      "catalogTruth": {
        "path": "${MORROW_MERIDIAN_CATALOG_PATH}",
        "fileSha256": "5234b664a8a4ae83c9459745c08a2b1943b3132152118b79b7771e1eeb7be9c5"
      },
      "runtimeProfile": {
        "kind": "catalog-hermetic",
        "profileId": "morrow-catalog",
        "environment": "test",
        "localOperator": "morrow-catalog",
        "sessionId": "catalog-list",
        "stateDirectory": "/tmp/morrow-meridian-catalog-profile",
        "mode": "read-only"
      },
      "priority": 100,
      "required": true,
      "enabled": true
    },
    {
      "id": "example-legacy",
      "label": "Morrow legacy browser runtime",
      "kind": "mcp-stdio",
      "command": "pnpm",
      "args": ["--filter", "@morrow/legacy-bridge-mcp", "start"],
      "cwd": "${MORROW_NEW_REPO_ROOT}",
      "repository": "example-org/example-legacy-source",
      "revision": "1111111111111111111111111111111111111111",
      "attestation": {
        "kind": "local-git",
        "root": "${MORROW_LEGACY_ROOT}",
        "expectedRevision": "1111111111111111111111111111111111111111",
        "requireTrackedClean": true
      },
      "priority": 50,
      "required": true,
      "enabled": true,
      "env": {
        "MORROW_LEGACY_CATALOG_PATH": "${MORROW_LEGACY_CATALOG_PATH}",
        "MORROW_LEGACY_EXPECTED_REVISION": "1111111111111111111111111111111111111111",
        "MORROW_LEGACY_BRIDGE_TOKEN": "${MORROW_LEGACY_BRIDGE_TOKEN}",
        "MORROW_LEGACY_BRIDGE_PORT": "${MORROW_LEGACY_BRIDGE_PORT:-32145}",
        "MORROW_LEGACY_ALLOWED_EXTENSION_IDS": "${MORROW_LEGACY_ALLOWED_EXTENSION_IDS:-}"
      }
    }
  ],
  "filters": {
    "excludePrefixes": ["mindtap_", "connect_"],
    "excludeNames": []
  },
  "operationJournal": {
    "path": "${MORROW_OPERATION_DB_PATH:-.morrow/morrow.sqlite3}"
  },
  "batchScheduler": {
    "maxConcurrentReadWindows": 2
  },
  "maxCatalogTools": 1000
}
