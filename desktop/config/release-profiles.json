{
  "schema": "morrow.release-profiles.v2",
  "profiles": {
    "private-full": {
      "visibility": "private",
      "providers": {
        "canvas": {
          "authorizationReceipt": "canvas_authorization",
          "liveProofReceipt": "canvas_live_proof"
        },
        "moodle": {
          "authorizationReceipt": "moodle_authorization",
          "liveProofReceipt": "moodle_live_proof"
        },
        "blackboard": {
          "authorizationReceipt": "blackboard_authorization",
          "liveProofExceptionReceipt": "blackboard_no_live_tenant_exception"
        }
      },
      "externalEvidenceReceipts": ["client_parity"],
      "promotionEvidenceReceipts": ["independent_clean_machine", "publication_authorization"],
      "include": ["*"],
      "exclude": ["packages/*/test/", "scripts/test/", "config/source-origin-ledger.json"],
      "description": "Complete tracked Morrow source for local evidence and private candidate use. It is not a publication payload."
    },
    "public-canvas": {
      "visibility": "public",
      "providers": {
        "canvas": {
          "authorizationReceipt": "canvas_authorization",
          "liveProofReceipt": "canvas_live_proof"
        },
        "moodle": {
          "authorizationReceipt": "moodle_authorization",
          "liveProofReceipt": "moodle_live_proof"
        },
        "blackboard": {
          "authorizationReceipt": "blackboard_authorization",
          "liveProofExceptionReceipt": "blackboard_no_live_tenant_exception"
        }
      },
      "externalEvidenceReceipts": ["client_parity"],
      "promotionEvidenceReceipts": ["independent_clean_machine", "publication_authorization"],
      "include": [
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.base.json",
        ".gitignore",
        "README.md",
        "ARCHITECTURE.md",
        "LIMITATIONS.md",
        "SOURCE-ORIGIN.md",
        "LICENSE",
        "packages/contracts/",
        "packages/gateway-core/",
        "packages/mcp-server/",
        "packages/operation-journal/",
        "packages/upstream-mcp/",
        "packages/batch-engine/",
        "packages/blackboard-learn-api/",
        "packages/bridge-protocol/",
        "packages/bridge-loopback/",
        "packages/canvas-api-catalog/",
        "packages/canvas-connector-mcp/",
        "packages/client-config/",
        "connector/extension/",
        "artifacts/canvas-api/",
        "docs/architecture/",
        "docs/release/",
        "docs/implementation/EXAMPLE-WORKTREE.md",
        "docs/implementation/MULTI-LMS-AND-LESSON-REVIEW.md",
        "config/publication-selections.example.json",
        "morrow.upstreams.connector.example.json",
        "morrow.upstreams.public-canvas.example.json",
        "scripts/generate-canvas-api-catalog.mjs",
        "scripts/sync-canvas-readback-plan.mjs",
        "scripts/package-canvas-connector.mjs",
        "scripts/package-mcp-bundle.mjs",
        "scripts/lib/deterministic-archive.mjs",
        "installer/shared/bridge-delivery.cjs",
        "installer/shared/bridge-updates.cjs",
        "installer/shared/packager-admission.cjs",
        "installer/shared/process-lifetime.cjs"
      ],
      "exclude": [
        "packages/*/test/",
        "packages/mcp-server/src/meridian-runtime-adapter.ts"
      ],
      "description": "Standalone Morrow MCP and Bridge source for Canvas, Moodle, and the Blackboard REST integration. The profile retains its historical name. Publication still requires current source-rights, provider-policy, live-proof, and independent-reproduction receipts."
    }
  }
}
