{
  "schema": "morrow.upstreams.v1",
  "profile": "public-canvas",
  "sourcePolicy": {
    "requireAttestation": true
  },
  "publicationPolicy": {
    "path": "${MORROW_PUBLICATION_POLICY_PATH}",
    "requiredForPublicProfile": true
  },
  "upstreams": [
    {
      "id": "canvas-public-adapter",
      "label": "Public Canvas adapter",
      "kind": "mcp-stdio",
      "command": "${MORROW_PUBLIC_CANVAS_ADAPTER_COMMAND}",
      "args": ["${MORROW_PUBLIC_CANVAS_ADAPTER_ENTRY}"],
      "repository": "${MORROW_PUBLIC_CANVAS_ADAPTER_REPOSITORY}",
      "revision": "${MORROW_PUBLIC_CANVAS_ADAPTER_REVISION}",
      "sourceDisposition": "clean_reimplementation",
      "attestation": {
        "kind": "local-git",
        "root": "${MORROW_PUBLIC_CANVAS_ADAPTER_ROOT}",
        "expectedRevision": "${MORROW_PUBLIC_CANVAS_ADAPTER_REVISION}",
        "requireTrackedClean": true,
        "expectedToolCount": 1
      },
      "priority": 100,
      "required": true,
      "enabled": true,
      "env": {},
      "outputPrivacy": {}
    }
  ],
  "filters": {
    "excludePrefixes": ["mindtap_", "connect_"],
    "excludeNames": []
  },
  "operationJournal": {
    "path": "${MORROW_OPERATION_DB_PATH:-.morrow/morrow.sqlite3}"
  },
  "batchScheduler": {
    "maxConcurrentWindows": 1
  },
  "maxCatalogTools": 1000
}
