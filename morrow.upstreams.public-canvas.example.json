{
  "schema": "morrow.upstreams.v1",
  "profile": "public-canvas",
  "sourcePolicy": {
    "requireAttestation": true
  },
  "publicationPolicy": {
    "path": "${MORROW_PUBLICATION_POLICY_PATH}",
    "requiredForPublicProfile": true
  },
  "upstreams": [
    {
      "id": "canvas-session",
      "label": "Morrow Canvas Connector",
      "kind": "mcp-stdio",
      "command": "${MORROW_NODE_COMMAND:-node}",
      "args": ["${MORROW_REPOSITORY_ROOT}/packages/canvas-connector-mcp/dist/index.js"],
      "cwd": "${MORROW_REPOSITORY_ROOT}",
      "env": {
        "MORROW_CANVAS_CATALOG_PATH": "${MORROW_REPOSITORY_ROOT}/artifacts/canvas-api/canvas-api-catalog.json"
      },
      "repository": "example-owner/morrow",
      "revision": "${MORROW_RELEASE_REVISION}",
      "sourceDisposition": "direct_owned",
      "attestation": {
        "kind": "local-git",
        "root": "${MORROW_REPOSITORY_ROOT}",
        "expectedRevision": "${MORROW_RELEASE_REVISION}",
        "requireTrackedClean": true,
        "expectedToolCount": 1132
      },
      "priority": 200,
      "required": true,
      "enabled": true,
      "outputPrivacy": {},
      "outputPrivacyDefault": {
        "allowedFields": [],
        "fieldPolicy": "scrub-sensitive",
        "dataClass": "learner",
        "maxRecords": 10000,
        "maxBytes": 2000000,
        "freeText": "allow",
        "learnerTokens": true,
        "artifactInspection": "deny",
        "aiClientAdmission": "allow"
      }
    }
  ],
  "filters": {
    "excludePrefixes": ["mindtap_", "connect_"],
    "excludeNames": []
  },
  "operationJournal": {
    "path": "${MORROW_OPERATION_DB_PATH:-.morrow/morrow.sqlite3}"
  },
  "batchScheduler": {
    "maxConcurrentWindows": 1
  },
  "privacy": {
    "canvasOrigin": "browser-session",
    "account": "local-browser-account",
    "principal": "local-browser-principal",
    "learnerVaultPath": ".morrow/learner-vault.json"
  },
  "maxCatalogTools": 2000
}
