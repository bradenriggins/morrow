{
  "schema": "morrow.upstreams.v1",
  "profile": "private-full",
  "sourcePolicy": {
    "requireAttestation": true
  },
  "upstreams": [
    {
      "id": "meridian",
      "label": "ExamplePlatform private runtime",
      "kind": "meridian-ssh",
      "host": "your-meridian-ssh-host",
      "remoteRoot": "/tmp/morrow-meridian-donor-00000000",
      "serverPath": "scripts/team/mcp/meridian_server.py",
      "repository": "your-org/your-meridian-repo",
      "revision": "0000000000000000000000000000000000000000",
      "attestation": {
        "kind": "remote-git-ssh",
        "host": "your-meridian-ssh-host",
        "root": "/tmp/morrow-meridian-donor-00000000",
        "expectedRevision": "0000000000000000000000000000000000000000",
        "requireTrackedClean": true
      },
      "catalogTruth": {
        "path": "${MORROW_MERIDIAN_CATALOG_PATH}",
        "fileSha256": "5234b664a8a4ae83c9459745c08a2b1943b3132152118b79b7771e1eeb7be9c5"
      },
      "runtimeProfile": {
        "kind": "private-runtime",
        "profileId": "morrow-private",
        "environment": "production",
        "localOperator": "morrow-operator",
        "sessionId": "morrow-session",
        "stateDirectory": "/tmp/morrow-meridian-private-profile",
        "mode": "edit",
        "canvasConnection": {
          "kind": "session-path",
          "path": "/tmp/morrow-meridian-private-profile/canvas-session.json"
        }
      },
      "supervision": {
        "startupAttempts": 3,
        "reconnectAttempts": 3,
        "initialBackoffMs": 100,
        "maxBackoffMs": 2000
      },
      "priority": 100,
      "required": true,
      "enabled": true
    }
  ],
  "filters": {
    "excludePrefixes": ["mindtap_", "connect_"],
    "excludeNames": []
  },
  "operationJournal": {
    "path": "${MORROW_OPERATION_DB_PATH:-.morrow/morrow.sqlite3}"
  },
  "batchScheduler": {
    "maxConcurrentReadWindows": 2
  },
  "maxCatalogTools": 1000
}
