# Runtime state and caches stay out of the repo. Product dirs keep their own
# build ignores (desktop/.gitignore covers the pnpm workspace).
.morrow/
*.lock
__pycache__/
.pytest_cache/
*.pyc
*.pyo
.DS_Store
Thumbs.db
# Test scratch (selftests recreate it at run time) and carve output.
.selftest-work/
.test-state/
/dist/
